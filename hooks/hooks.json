{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node ./scripts/pre-tool-use.mjs",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./scripts/pre-tool-use.mjs",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node ./scripts/post-tool-use.mjs",
        "matcher": "Shell|MCP:",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node ./scripts/post-tool-use.mjs",
        "matcher": "Shell|MCP:",
        "timeout": 10
      }
    ]
  }
}
